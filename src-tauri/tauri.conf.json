{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foliver",
  "version": "0.1.0",
  "identifier": "com.alice.legado",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Foliver"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "iOS": {
      "template": "src-tauri/ios-project.yml"
    },
    "resources": {
      "../kotlin/build/source-engine/runtime": "source-engine/"
    },
    "fileAssociations": [
      {
        "ext": [
          "txt"
        ],
        "name": "TXT Book",
        "description": "Foliver text book",
        "mimeType": "text/plain",
        "role": "Viewer"
      },
      {
        "ext": [
          "epub"
        ],
        "name": "EPUB Book",
        "description": "Foliver EPUB book",
        "mimeType": "application/epub+zip",
        "role": "Viewer"
      },
      {
        "ext": [
          "cbz"
        ],
        "name": "CBZ Comic Book",
        "description": "Foliver CBZ comic book",
        "mimeType": "application/vnd.comicbook+zip",
        "role": "Viewer"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Book",
        "description": "Foliver PDF book",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "legado-rs",
            "legado",
            "yuedu"
          ]
        }
      ],
      "desktop": {
        "schemes": [
          "legado-rs",
          "legado",
          "yuedu"
        ]
      }
    }
  }
}
